export module Plotter;
import Canvas;
import MathEngine;
import Config;
import CoordinateSystem;

export class Plotter {
private:
    Canvas& canvas;

public:
    Plotter(Canvas& c) : canvas(c) {}

    void render(Math::MathFunc f, PlotSettings::Range xRange, int W, int H) {
        drawAxes(canvas, W, H);

        for (int px = 0; px < W; ++px) {
            /**
             * Масштабуємо X з пікселів у математичне значення
             * Цей рядок — це звичайна математична лінеарна інтерполяція (або "мапінг"). Його задача — перевести координату
             * "пікселя" (яка завжди ціле число від 0 до 80) у "математичне значення" x (яке може бути від -10 до 10).
             *
             * 1. Частка (px / static_cast<double>(W))
             *  Це ми знаходимо відсоток проходження по екрану
             *  .px — це номер поточного пікселя (наприклад, 40).
             *  W — ширина екрана (80).
             *  Результат: 40 / 80.0 = 0.5. Тобто ми зараз рівно посередині екрана.
             *  Важливо: static_cast<double> потрібен, щоб C++ не зробив "цілочисельне ділення". Без нього 40/80 було б просто 0.
             *
             * 2. Частка (xRange.max - xRange.min)
             *  Це ширина нашого математичного світу. Якщо ми хочемо графік від -10 до 10, то ширина дорівнює 10 - (-10) = 20.
             *  Це те, скільки "математичних одиниць" вміщується в усьому екрані.
             *
             * 3. Множення: Відсоток * Ширину
             *  Ми дізнаємося, яку відстань ми пройшли від початку графіка.
             *  0.5 * 20 = 10. Тобто ми відступили від лівого краю на 10 одиниць.
             *
             * 4. Додавання xRange.min + ...
             *  Ми додаємо отриманий відступ до початкової точки.
             *  -10 (початок) +10 (відступ) = 0.
             *  Результат: Піксель номер 40 на екрані шириною 80 відповідає математичному x = 0.
             *
             *
             * Розглянемо приклад для діапазону [-10;10]
             *
             * Що маємо (Пікселі)              Розрахунок              Що отримуємо (x)
             * 0 (лівий край)                  -10 + (0/80) * 20       -10
             * 40 (центр)                      -10 + (40/80) * 20       0
             * 80 (правий край)                -10 + (80/80) * 20       10
             *
             */

            double x = xRange.min + (px / static_cast<double>(W)) * (xRange.max - xRange.min);
            double y = f(x);

            /**
             * Перетворюємо Y у координату рядка (інверсія)
             * Це такий самий «міст», як і для x, але з двома важливими нюансами, характерними для комп'ютерної графіки та консолі.
             * Цей рядок перетворює математичне значення y (наприклад, 0 або 1) у номер рядка в консолі.
             *
             *
             * 1. Чому H / 2 на початку?
             *  У математиці $y = 0$ — це центр графіка. Але в консолі (і в більшості віконних систем) координата (0, 0)
             *  знаходиться в верхньому лівому куті.
             *  Рядок 0 — це самий верх.
             *  Рядок H/2 — це рівно середина висоти екрана.Ми беремо середину як "точку відліку", щоб наш нуль функцій був по центру консолі.
             *
             * 2. Чому мінус перед дужкою: - (y * ...)?
             *  Це найважливіший момент.У математиці: чим більше y, тим вище точка.
             *  У консолі: чим більше номер рядка, тим нижче він знаходиться. Щоб графік не відобразився "догори ногами", ми використовуємо мінус.
             *  Коли y зростає, ми віднімаємо це значення від середини екрана, і точка "піднімається" до нульового рядка.
             *
             * 3. Що таке H / 4?
             *  Це масштабний коефіцієнт (зум) по вертикалі. Якщо наша функція (наприклад, синус) повертає y від -1 до 1, то без
             *  масштабування вона займала б лише 2 пікселі (рядки) в консолі. Це був би просто рівний рядок.
             *  Множачи на H / 4, ми кажемо: "Нехай одиниця по y займає чверть висоти екрана".
             *  Наприклад, якщо висота H = 40, то y=1 стане точкою 20 - (1 * 10) = 10. Тобто на 10 рядків вище центру.
             *  Так само і для інших функій, як log чи x^2.
             *
             * Приклад розрахунку (при H = 40)
             *
             * Значення y (математичне)              Розрахунок: 20 - (y * 10)              Номер рядка в консолі (py)
             * 1.0 (макс. синуса)                    20 - (1.0 * 10) = 10                   10 (верхня частина)
             * 0.0 (нуль)                            20 - (0.0 * 10) = 20                   20 (середина)
             * -1.0 (мін. синуса)                    20 - (-1.0 * 10) = 30                  30 (нижня частина)
             *
             */
            int py = static_cast<int>(H / 2 - (y * (H / 4)));


            if (py >= 0 && py < H) {
                canvas.setCustomPoint(px, py, PlotSettings::PLOT_SYMBOL);
            }
        }
    }

};